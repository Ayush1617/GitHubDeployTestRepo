<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Record_Type_Must_Be_Supplier</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
   ISNEW(),
   RecordType.DeveloperName &lt;&gt; &quot;Supplier__c&quot;
)</errorConditionFormula>
    <errorMessage>This record must be of Record Type Supplier.</errorMessage>
</ValidationRule>
