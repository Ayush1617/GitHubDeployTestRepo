<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Supplier_StartDate_less_than_EndDate</fullName>
    <active>true</active>
    <description>Start Date Should be Less than EndDate</description>
    <errorConditionFormula>AND(
    RecordType.DeveloperName = &quot;Partner_Community_Supplier&quot;,
    Agreement_Start_Date__c &gt; Agreement_End_Date__c
)</errorConditionFormula>
    <errorMessage>Start Date must be earlier than End Date.</errorMessage>
</ValidationRule>
