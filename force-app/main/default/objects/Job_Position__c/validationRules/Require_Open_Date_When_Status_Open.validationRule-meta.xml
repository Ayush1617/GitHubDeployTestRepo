<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Require_Open_Date_When_Status_Open</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Status__c , &quot;Open&quot;),
    ISBLANK(Open_Date__c)
)</errorConditionFormula>
    <errorDisplayField>Open_Date__c</errorDisplayField>
    <errorMessage>Open Date is required when Status is Open.</errorMessage>
</ValidationRule>
