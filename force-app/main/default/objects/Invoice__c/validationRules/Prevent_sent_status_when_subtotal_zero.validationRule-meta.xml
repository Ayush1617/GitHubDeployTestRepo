<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Prevent_sent_status_when_subtotal_zero</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Status__c, &quot;Sent&quot;),
    Subtotal__c = 0
)</errorConditionFormula>
    <errorMessage>Invoice cannot be marked as Sent when Subtotal is 0.</errorMessage>
</ValidationRule>
